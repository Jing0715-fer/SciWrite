# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example template IS committed (contains no secrets).
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# agent tool output dumps (repo hygiene — review finding)
/tool-results/
# dev server pid
.zscripts/dev.pid
# user-uploaded files (exported PDFs sent for review etc.)
/upload/
.tmp-*

# auto-iterate runtime artifacts (metrics/reports/last-good ARE tracked)
iteration-state/round.lock
iteration-state/round-console.log
iteration-state/scheduler-heartbeat.json
iteration-state/scheduler-console.log
iteration-state/console-heartbeat.json
iteration-state/scheduler.json

# round-RT3 (R8/O1): the SQLite database must never be git-tracked —
# a git stash during a live run swaps the file under the dev server's
# SQLite handle ("readonly database" at compose) and 40MB blobs bloat
# every clone. Back it up OUTSIDE the repo if needed.
db/custom.db
db/*.db

# round-RT4 (P0-1): persisted rate-abort state is runtime-local, not source.
db/rate-abort.json
