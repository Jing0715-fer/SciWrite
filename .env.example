# SciWrite environment configuration — copy to .env and fill in values.
# (.env is gitignored; never commit real secrets.)

# --- Database (Prisma + SQLite) ---
DATABASE_URL=file:/home/z/my-project/db/custom.db

# --- Backend auth (round-7, NextAuth v4 Credentials + JWT) ---
# Master toggle: false or absent = NO login required (default; the app
# behaves like a pre-round-7 open single-user tool). Set to true to
# re-enable the login gate (SessionGate login card + proxy.ts 401
# enforcement on every /api/* route). Requires a dev-server restart /
# redeploy after changing (NEXT_PUBLIC_* is inlined at compile time).
NEXT_PUBLIC_AUTH_ENABLED=false

# Only used when NEXT_PUBLIC_AUTH_ENABLED=true:
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=<replace-with-random-secret>
# Login username (single-user self-hosted model)
AUTH_USERNAME=researcher
# SHA-256 hex of the login password:
#   printf '%s' 'your-password' | openssl dgst -sha256
AUTH_PASSWORD_SHA256=<replace-with-sha256-of-password>
